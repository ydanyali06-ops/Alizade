<!DOCTYPE html>
<html lang="fa">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Simple AI Chat</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #111;
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .chat {
      width: 95%;
      max-width: 600px;
      height: 90vh;
      background: #1c1c1c;
      border-radius: 18px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .header {
      padding: 18px;
      text-align: center;
      font-size: 20px;
      font-weight: bold;
      border-bottom: 1px solid #333;
    }

    #messages {
      flex: 1;
      padding: 15px;
      overflow-y: auto;
    }

    .message {
      max-width: 80%;
      padding: 12px 15px;
      margin: 8px 0;
      border-radius: 14px;
      line-height: 1.5;
      word-wrap: break-word;
    }

    .user {
      background: #333;
      margin-left: auto;
    }

    .ai {
      background: #252525;
      margin-right: auto;
    }

    .input-area {
      display: flex;
      padding: 12px;
      gap: 8px;
      border-top: 1px solid #333;
    }

    input {
      flex: 1;
      padding: 13px;
      border: none;
      outline: none;
      border-radius: 12px;
      background: #333;
      color: white;
      font-size: 15px;
    }

    button {
      border: none;
      border-radius: 12px;
      padding: 0 18px;
      background: white;
      color: black;
      cursor: pointer;
      font-weight: bold;
    }

    button:hover {
      opacity: 0.8;
    }
  </style>
</head>

<body>

  <div class="chat">

    <div class="header">
      🤖 Simple AI
    </div>

    <div id="messages"></div>

    <div class="input-area">
      <input
        id="messageInput"
        type="text"
        placeholder="پیامت را بنویس..."
        onkeydown="if(event.key === 'Enter') sendMessage()"
      >

      <button onclick="sendMessage()">
        ارسال
      </button>
    </div>

  </div>

<script>

async function sendMessage() {

  const input = document.getElementById("messageInput");
  const text = input.value.trim();

  if (!text) return;

  addMessage(text, "user");

  input.value = "";

  addMessage("در حال فکر کردن...", "ai");

  try {

    /*
      این قسمت باید به API هوش مصنوعی خودت وصل شود.

      مثال:
      const response = await fetch("YOUR_API_URL", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          message: text
        })
      });

      const data = await response.json();
      const answer = data.answer;
    */

    // فعلاً برای تست:
    await new Promise(resolve => setTimeout(resolve, 700));

    const answer =
      "پیامت دریافت شد: " + text;

    const messages = document.getElementById("messages");
    messages.lastElementChild.remove();

    addMessage(answer, "ai");

  } catch (error) {

    const messages = document.getElementById("messages");

    if (messages.lastElementChild) {
      messages.lastElementChild.remove();
    }

    addMessage("خطایی رخ داد.", "ai");
  }
}


function addMessage(text, type) {

  const messages = document.getElementById("messages");

  const div = document.createElement("div");

  div.className = "message " + type;

  div.textContent = text;

  messages.appendChild(div);

  messages.scrollTop = messages.scrollHeight;
}

</script>

</body>
</html>
